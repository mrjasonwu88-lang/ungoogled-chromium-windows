+// [MoCi ext-protect] Parse --moci-locked-extensions=<id1>,<id2> at startup,
+// then implement ManagementPolicy::Provider so chromium treats those
+// extensions as if installed by enterprise policy:
+//   - UserMayModifySettings = false (Remove/Disable hidden in chrome://extensions)
+//   - MustRemainEnabled = true (Disable toggle grayed out)
+//   - MustRemainInstalled = true (uninstall API call fails)
+class MoCiLockedExtensionProvider : public ManagementPolicy::Provider {
+ public:
+  MoCiLockedExtensionProvider() {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd->HasSwitch(::switches::kMoCiLockedExtensions)) {
+      return;
+    }
+    std::string val =
+        cmd->GetSwitchValueASCII(::switches::kMoCiLockedExtensions);
+    for (const auto& id : base::SplitString(
+             val, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      locked_ids_.insert(id);
+    }
+  }
+  ~MoCiLockedExtensionProvider() override = default;
+
+  std::string GetDebugPolicyProviderName() const override {
+    return "MoCi LockedExtension";
+  }
+  bool UserMayModifySettings(const Extension* extension,
+                             std::u16string* error) const override {
+    return !locked_ids_.contains(extension->id());
+  }
+  // NB: 不实现 MustRemainEnabled — chromium 内部 Reload 走
+  // DisableExtension(REASON_RELOAD) + EnableExtension。强制 enable 会让 Reload
+  // 拒，UI 状态错乱让 extension 看似消失。改设置/disable toggle 仍被
+  // UserMayModifySettings=false 拦住。
+  bool MustRemainInstalled(const Extension* extension,
+                           std::u16string* error) const override {
+    return locked_ids_.contains(extension->id());
+  }
+
+ private:
+  std::set<std::string> locked_ids_;
+};
+
+ManagementPolicy::Provider* GetMoCiLockedExtensionProvider() {
+  static base::NoDestructor<MoCiLockedExtensionProvider> provider;
+  return provider.get();
+}
+
 }  // namespace
 
