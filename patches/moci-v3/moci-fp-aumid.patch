 std::wstring ShellUtil::GetBrowserModelId(bool is_per_user_install) {
+  // [MoCi fp-aumid] 让多 env chromium 进程在 Windows 任务栏分组到独立 group。
+  // chromium 默认 AUMID 公式让同一 binary 的多 env 全部撞到一个 group。
+  // 在 SetCurrentProcessExplicitAppUserModelID + SetAppIdForWindow 顶层入口
+  // 读 --moci-aumid switch 覆盖默认值。
+  {
+    const base::CommandLine& moci_cmd = *base::CommandLine::ForCurrentProcess();
+    if (moci_cmd.HasSwitch("moci-aumid")) {
+      std::wstring moci_aumid = moci_cmd.GetSwitchValueNative("moci-aumid");
+      if (!moci_aumid.empty())
+        return moci_aumid;
+    }
+  }
   std::wstring app_id(install_static::GetBaseAppId());
   std::wstring suffix;
 
