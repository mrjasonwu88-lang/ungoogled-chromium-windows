 std::wstring GetAppUserModelIdForApp(const std::wstring& app_name,
                                      const base::FilePath& profile_path) {
+  // [MoCi fp-aumid] --moci-aumid switch 覆盖默认 AUMID 算法。
+  // BrowserWindowPropertyManager::UpdateWindowProperties 调到此函数给
+  // 每个 BrowserWindow.hwnd 设 AUMID；override 让窗口级 AUMID 跟随 env。
+  {
+    const base::CommandLine& moci_cmd = *base::CommandLine::ForCurrentProcess();
+    if (moci_cmd.HasSwitch("moci-aumid")) {
+      std::wstring moci_aumid = moci_cmd.GetSwitchValueNative("moci-aumid");
+      if (!moci_aumid.empty())
+        return moci_aumid;
+    }
+  }
   return GetAppUserModelIdImpl(install_static::GetBaseAppId(), app_name,
                                profile_path);
 }
 
 std::wstring GetAppUserModelIdForBrowser(const base::FilePath& profile_path) {
+  // [MoCi fp-aumid] 同 GetAppUserModelIdForApp，覆盖 normal browser window 路径。
+  {
+    const base::CommandLine& moci_cmd = *base::CommandLine::ForCurrentProcess();
+    if (moci_cmd.HasSwitch("moci-aumid")) {
+      std::wstring moci_aumid = moci_cmd.GetSwitchValueNative("moci-aumid");
+      if (!moci_aumid.empty())
+        return moci_aumid;
+    }
+  }
   return GetAppUserModelIdImpl(
       std::wstring(),
       ShellUtil::GetBrowserModelId(InstallUtil::IsPerUserInstall()),
