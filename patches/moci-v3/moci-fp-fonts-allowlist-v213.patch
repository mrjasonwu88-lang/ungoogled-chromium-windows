+  // [MoCi v.213 SW-12] Fonts allowlist enforcement
+  // 如 fingerprint-config 配 fonts.list 白名单 + fonts.mode != "real"，
+  // 不在白名单的 family 返 nullptr → CSS font-matching fallback chain
+  //   走下一个 family（'Georgia, monospace' → fall through 到 monospace）
+  // → SW-12 detector span.offsetWidth 跟 defaultWidth 一致 → 字体不暴露存在
+  // 副作用：用户访问 font-family: Georgia 网页 fallback 到 serif/system，视觉略变
+  //   但不会光秃（CSS generic fallback 保证）。trade-off 换 fingerprint 一致性。
+  if (!family.empty() && moci::ShouldFilterFonts() &&
+      !moci::IsFontAllowed(family.Utf8())) {
+    return nullptr;
+  }
