+namespace {
+
+// [MoCi fp-fonts] 每 env chromium 进程独立字体白名单 (cross-env Fonts hash 独立)
+// 启动时从 --moci-fonts-list=Arial,Verdana,... switch 一次性 parse 进静态 set。
+// CreateTypeface() 拦截 family 不在 list 里时返 nullptr → 上游 CSS fallback 到 monospace
+// → offsetWidth 不变化 → JS 检测判定"字体不可用"→ Fonts hash 跨 env 独立。
+//
+// 行业方案（Brave Shields fonts farbling 同手法）：family 白名单 + 启动 switch 注入。
+// 无 switch 时 set 为空 → MoCiIsFontFarblingEnabled() 返 false → 所有字体 allow（向后兼容）。
+//
+// baseline 系统字体永远 allow，避免子集太诡异让网站怀疑（缺 Arial / Times New Roman 是异常信号）。
+
+const char kMoCiFontsListSwitch[] = "moci-fonts-list";
+
+const char* const kMoCiBaselineFonts[] = {
+  "Arial", "Helvetica", "Times New Roman", "Times",
+  "Verdana", "Tahoma", "Courier New", "Courier",
+  "monospace", "sans-serif", "serif", "cursive", "fantasy",
+};
+
+struct MoCiFarblingState {
+  bool enabled = false;
+  std::unordered_set<std::string> allowed_lowercase;
+};
+
+const MoCiFarblingState& MoCiGetFarblingState() {
+  static base::NoDestructor<MoCiFarblingState> state([]() {
+    MoCiFarblingState s;
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch(kMoCiFontsListSwitch)) {
+      return s;
+    }
+    std::string raw = cmd->GetSwitchValueASCII(kMoCiFontsListSwitch);
+    if (raw.empty()) {
+      return s;
+    }
+    s.enabled = true;
+    // baseline 永远 allow，先放进 set
+    for (const char* baseline : kMoCiBaselineFonts) {
+      s.allowed_lowercase.insert(base::ToLowerASCII(baseline));
+    }
+    // 逗号分隔 parse + lowercase 归一化
+    std::vector<std::string> families = base::SplitString(
+        raw, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    for (const std::string& family : families) {
+      s.allowed_lowercase.insert(base::ToLowerASCII(family));
+    }
+    return s;
+  }());
+  return *state;
+}
+
+bool MoCiIsFontAllowed(const std::string& family) {
+  const MoCiFarblingState& state = MoCiGetFarblingState();
+  if (!state.enabled) {
+    return true;  // 无 switch = farbling 关闭，所有字体 allow
+  }
+  return state.allowed_lowercase.count(base::ToLowerASCII(family)) > 0;
+}
+
