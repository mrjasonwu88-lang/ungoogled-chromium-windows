[MoCi Phase 3-B B-2] Accept-Language + navigator.language 联动 spoofing

涉及 2 文件：
  - net/url_request/url_request_http_job.cc — HTTP Accept-Language header 替换
  - third_party/blink/renderer/core/frame/navigator_language.cc — navigator.languages 替换

两个入口共用 moci::ShouldOverrideAcceptLanguage / GetSpoofedAcceptLanguage，
让请求 header 跟 JS 暴露层 100% 一致。

diff --git a/net/url_request/url_request_http_job.cc b/net/url_request/url_request_http_job.cc
index 86a601592c..7fc26b34f8 100644
--- a/net/url_request/url_request_http_job.cc
+++ b/net/url_request/url_request_http_job.cc
@@ -15,6 +15,7 @@
 #include "base/base_switches.h"
 #include "base/check_op.h"
 #include "base/command_line.h"
+#include "components/moci/fingerprint_helpers.h"
 #include "base/compiler_specific.h"
 #include "base/feature_list.h"
 #include "base/file_version_info.h"
@@ -806,6 +807,17 @@ void URLRequestHttpJob::AddExtraHeaders() {
       request()->context()->enable_brotli(),
       request()->context()->enable_zstd());
 
+  // === MoCi Browser: Accept-Language Spoofing (Phase 3-B B-2) ===
+  // 按 proxy.country 派生的 Accept-Language 优先（kernel-manager.ts 派生）
+  // 跟 navigator.language / Intl.locale 同源，CreepJS 联动一致性必须
+  if (moci::ShouldOverrideAcceptLanguage()) {
+    request_info_.extra_headers.SetHeaderIfMissing(
+        HttpRequestHeaders::kAcceptLanguage,
+        moci::GetSpoofedAcceptLanguage());
+    return;
+  }
+  // === End MoCi Browser Modification ===
+
   if (http_user_agent_settings_) {
     // Only add default Accept-Language if the request didn't have it
     // specified.
