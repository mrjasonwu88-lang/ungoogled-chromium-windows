 void NavigatorLanguage::EnsureUpdatedLanguage() {
+  // === MoCi Browser: navigator.language Spoofing (Phase 3-B B-2 配套) ===
+  // 用 fp-config 里 acceptLanguage 派生 navigator.language/languages
+  // 跟 Accept-Language HTTP header (url_request_http_job.cc) 同源
+  // 不只重写 Accept-Language wire，JS API navigator.language/languages 也跟着变
+  if (moci::ShouldOverrideAcceptLanguage()) {
+    languages_ = ParseAndSanitize(String::FromUtf8(moci::GetSpoofedAcceptLanguage()));
+    languages_dirty_ = false;
+    return;
+  }
+  // === End MoCi Browser Modification ===
+
   String accept_languages_override;
   probe::ApplyAcceptLanguageOverride(execution_context_,
                                      &accept_languages_override);
