+void MoCiEnvIndicatorView::ShowTooltipNow() {
+  if (tooltip_widget_) return;
+  if (!GetWidget()) return;
+  if (tooltip_text_.empty()) return;
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_TOOLTIP);
+  params.parent = GetWidget()->GetNativeView();
+  params.accept_events = true;
+  // v11f: kTranslucent 让 widget 的 HWND 支持透明，四角才能真透
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  // v11g: 不要 chromium 的 kDrop shadow — 它沿方形 HWND 边界绘，露 90° 角
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+
+  // popup 内容: 白底圆角；用 layer + GPU 裁圆角让 4 角真透
+  auto contents = std::make_unique<views::View>();
+  contents->SetPaintToLayer();
+  contents->layer()->SetFillsBoundsOpaquely(false);
+  contents->layer()->SetMasksToBounds(true);
+  contents->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(10));
+  contents->layer()->SetIsFastRoundedCorner(true);
+  contents->SetBackground(
+      views::CreateRoundedRectBackground(kTooltipBgColor, 10));
+  contents->SetBorder(views::CreatePaddedBorder(
+      views::CreateRoundedRectBorder(1, 10, kTooltipBorderColor),
+      gfx::Insets::VH(8, 6)));
+  auto* contents_layout =
+      contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical, gfx::Insets(), 0));
+  contents_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+
+  // v4.6.6+: 重设计 — 6 行（账号/团队/平台/出口/ISP/在线）+ 「自检环境」按钮
+  //   ▸ "公司" → "团队"（语义对齐 currentOrg）
+  //   ▸ IP + 区域 合并成一行 "出口" → "47.239.206.40 · 香港"
+  //   ▸ 新增 "在线" 行（动态秒级刷新，依赖 duration_timer_ tick）
+  //   ▸ 底部 "🩺 自检环境" 按钮 → 新 tab 打开 fingerprint.moci
+  duration_value_label_ = nullptr;  // 重建前清旧引用
+
+  struct Row { std::u16string label; std::u16string value; bool is_group_end; };
+  std::vector<Row> rows;
+
+  // 账号组
+  std::string acc_val = env_number_.empty() ? account_name_
+                          : "#" + env_number_ + " " + account_name_;
+  rows.push_back({u"账号", base::UTF8ToUTF16(acc_val), false});
+  if (!company_name_.empty()) {
+    rows.push_back({u"团队", base::UTF8ToUTF16(company_name_), false});
+  }
+  if (!platform_.empty()) {
+    std::string plat = platform_;
+    if (!platform_site_.empty()) plat += " · " + platform_site_;
+    rows.push_back({u"平台", base::UTF8ToUTF16(plat), false});
+  }
+  if (!account_email_.empty()) {
+    rows.push_back({u"邮箱", base::UTF8ToUTF16(account_email_), false});
+  }
+  if (!rows.empty()) rows.back().is_group_end = true;  // 账号组末尾
+
+  // 代理组：IP + 区域 合并成"出口"
+  std::string egress = ip_address_;
+  if (!instance_region_.empty()) {
+    if (!egress.empty()) egress += " · ";
+    egress += instance_region_;
+  }
+  if (!egress.empty()) {
+    rows.push_back({u"出口", base::UTF8ToUTF16(egress), false});
+  }
+  if (!instance_type_.empty()) {
+    rows.push_back({u"ISP", base::UTF8ToUTF16(instance_type_), false});
+  }
+  if (!rows.empty()) rows.back().is_group_end = true;  // 代理组末尾
+
+  // v4.6.6+: 在线时长行（startedAtUnix > 0 才显示）
+  size_t duration_row_idx = SIZE_MAX;
+  if (started_at_unix_ > 0) {
+    rows.push_back({u"在线", BuildDurationText(), false});
+    duration_row_idx = rows.size() - 1;
+  }
+
+  // 添加：除最后一行外都加 bottom separator；记下"在线"行的 value_label 给 timer 用
+  for (size_t i = 0; i < rows.size(); ++i) {
+    bool is_last = (i == rows.size() - 1);
+    auto row = std::make_unique<CopyableFieldRow>(
+        rows[i].label, rows[i].value, !is_last);
+    // duration row 的 value Label 指针留下来让 RefreshDurationRow() 改文案
+    if (i == duration_row_idx) {
+      duration_value_label_ = row->GetValueLabelForLiveUpdate();
+    }
+    contents->AddChildView(std::move(row));
+    // 账号组 / 代理组末尾后插入间隔（高 6px 视觉分组）
+    if (rows[i].is_group_end && !is_last) {
+      auto gap = std::make_unique<views::View>();
+      gap->SetPreferredSize(gfx::Size(0, 6));
+      contents->AddChildView(std::move(gap));
+    }
+  }
+
+  // v4.6.6+: 底部「🩺 自检环境」按钮（独立 row，居中显示，hover 高亮，click → 打开 fingerprint.moci）
+  {
+    auto gap = std::make_unique<views::View>();
+    gap->SetPreferredSize(gfx::Size(0, 4));
+    contents->AddChildView(std::move(gap));
+    contents->AddChildView(std::make_unique<SelfCheckButtonRow>(
+        base::BindRepeating(&MoCiEnvIndicatorView::OnSelfCheckClicked,
+                            weak_factory_.GetWeakPtr())));
+  }
+
+  tooltip_widget_ = std::make_unique<views::Widget>();
+  tooltip_widget_->Init(std::move(params));
+  auto* contents_ptr =
+      tooltip_widget_->SetContentsView(std::move(contents));
+
+  // 计算 popup 位置：bar 正下方左对齐，留 6px gap
+  gfx::Size sz = contents_ptr->GetPreferredSize();
+  gfx::Rect bar_screen = GetBoundsInScreen();
+  gfx::Rect bounds(bar_screen.x(), bar_screen.bottom() + 6, sz.width(),
+                   sz.height());
+  tooltip_widget_->SetBounds(bounds);
+  tooltip_widget_->ShowInactive();
+
+  // v4.6.6+: 在线时长行：popup 打开后每秒 tick 刷文案；duration_value_label_
+  //   是 popup 内 views::Label 弱引用，popup 关闭时 HideTooltip 已 reset 走光
+  if (duration_value_label_ && started_at_unix_ > 0) {
+    duration_timer_.Start(FROM_HERE, base::Seconds(1),
+                          base::BindRepeating(
+                              &MoCiEnvIndicatorView::RefreshDurationRow,
+                              base::Unretained(this)));
+  }
+}
+
+void MoCiEnvIndicatorView::HideTooltip() {
+  // v4.6.6+: 先停 timer 防止 timer 回调访问已 reset 的 widget
+  duration_timer_.Stop();
+  duration_value_label_ = nullptr;
+  if (tooltip_widget_) {
+    tooltip_widget_->Close();
+    tooltip_widget_.reset();
+  }
+}
+
+std::u16string MoCiEnvIndicatorView::BuildDurationText() const {
+  if (started_at_unix_ <= 0) return u"--";
+  int64_t now = (base::Time::Now() - base::Time::UnixEpoch()).InSeconds();
+  int64_t elapsed = now - started_at_unix_;
+  if (elapsed < 0) elapsed = 0;
+  if (elapsed < 60) {
+    return base::UTF8ToUTF16("已运行 " + base::NumberToString(elapsed) + " 秒");
+  }
+  int64_t mins = elapsed / 60;
+  if (mins < 60) {
+    return base::UTF8ToUTF16("已运行 " + base::NumberToString(mins) + " 分钟");
+  }
+  int64_t hours = mins / 60;
+  int64_t rem_mins = mins % 60;
+  return base::UTF8ToUTF16(
+      "已运行 " + base::NumberToString(hours) + " 小时 " +
+      base::NumberToString(rem_mins) + " 分");
+}
+
+void MoCiEnvIndicatorView::RefreshDurationRow() {
+  if (!duration_value_label_) {
+    duration_timer_.Stop();
+    return;
+  }
+  duration_value_label_->SetText(BuildDurationText());
+}
+
+void MoCiEnvIndicatorView::OnSelfCheckClicked() {
+  if (!GetWidget()) return;
+  // 从当前 LocationBar 所在 Widget 反查 Browser，新 tab 打开自检页
+  Browser* browser = chrome::FindBrowserWithWindow(GetWidget()->GetNativeWindow());
+  if (!browser) return;
+  NavigateParams params(browser, GURL("https://fingerprint.moci/"),
+                        ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  HideTooltip();
+}
