+void MoCiEnvIndicatorView::BuildRows() {
+  rows_.clear();
+  inline_egress_idx_ = SIZE_MAX;
+  inline_duration_idx_ = SIZE_MAX;
+  inline_duration_label_ = nullptr;
+
+  // v4.6.8+: inline bar 滚 6 行（跟 popup 对齐）— 账号 / 团队 / 平台 / 出口 / ISP / 在线
+  //   不再合并 r1 = 账号+平台（各占一行更清楚）；邮箱常空不再单独留位
+
+  // Row: 账号
+  if (!account_name_.empty()) {
+    std::string s = env_number_.empty()
+        ? account_name_
+        : "#" + env_number_ + " " + account_name_;
+    rows_.push_back({std::u16string(), base::UTF8ToUTF16(s)});
+  }
+  // Row: 团队
+  if (!company_name_.empty()) {
+    rows_.push_back({std::u16string(), base::UTF8ToUTF16(company_name_)});
+  }
+  // Row: 平台
+  if (!platform_.empty()) {
+    std::string s = platform_;
+    if (!platform_site_.empty()) s += " · " + platform_site_;
+    rows_.push_back({std::u16string(), base::UTF8ToUTF16(s)});
+  }
+  // Row: 出口 (IP + region 合并)
+  std::string egress;
+  if (!ip_address_.empty()) egress = ip_address_;
+  if (!instance_region_.empty()) {
+    if (!egress.empty()) egress += " · ";
+    egress += instance_region_;
+  }
+  if (!egress.empty()) {
+    inline_egress_idx_ = rows_.size();
+    rows_.push_back({std::u16string(), base::UTF8ToUTF16(egress)});
+  }
+  // Row: ISP
+  if (!instance_type_.empty()) {
+    rows_.push_back({std::u16string(), base::UTF8ToUTF16(instance_type_)});
+  }
+  // Row: 在线（动态，依赖 BuildDurationText 重算）
+  if (started_at_unix_ > 0) {
+    inline_duration_idx_ = rows_.size();
+    rows_.push_back({std::u16string(), BuildDurationText()});
+  }
+
+  // v4.6.8+: 用"出口"行宽度作为整个 bar 的固定宽度（语义对齐）
+  //   inline_egress_idx_ 无效（无 IP）则退到 rows_.back()
+  if (!rows_.empty()) {
+    const gfx::FontList font = GetMoCiFontList();
+    size_t width_idx = inline_egress_idx_ != SIZE_MAX
+                         ? inline_egress_idx_
+                         : rows_.size() - 1;
+    const InfoRow& width_row = rows_[width_idx];
+    int width_w = gfx::GetStringWidth(width_row.content, font);
+    measured_width_ = width_w + kHorizontalPadding * 2 + 4;
+  }
+
+  // wrap 优化：末尾追加 row[0] 副本
+  if (scroll_container_) {
+    scroll_container_->RemoveAllChildViews();
+    row_views_.clear();
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      auto* row_view = scroll_container_->AddChildView(MakeRowView(rows_[i]));
+      row_views_.push_back(row_view);
+      // 保存"在线"行的 Label 指针让 OnTick 实时改文案
+      if (i == inline_duration_idx_ && !row_view->children().empty()) {
+        inline_duration_label_ = static_cast<views::Label*>(row_view->children()[0]);
+      }
+    }
+    if (rows_.size() > 1) {
+      scroll_container_->AddChildView(MakeRowView(rows_[0]));
+    }
+  }
+}
+
+std::unique_ptr<views::View> MoCiEnvIndicatorView::MakeRowView(
+    const InfoRow& info) {
+  const gfx::FontList font = GetMoCiFontList();
+  auto row = std::make_unique<views::View>();
+  auto* layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 0));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  auto content = std::make_unique<views::Label>(
+      info.content, views::Label::CustomFont{font});
+  content->SetEnabledColor(kContentColor);
+  content->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  content->SetElideBehavior(gfx::ELIDE_TAIL);
+  // 禁用 Label 自动 tooltip（避免和我们的自建 popup tooltip 重叠显示）
+  content->SetHandlesTooltips(false);
+  auto* content_ptr = row->AddChildView(std::move(content));
+  layout->SetFlexForView(content_ptr, 1);
+  row->SetPreferredSize(gfx::Size(0, kRowHeight));
+  return row;
+}
