+// [MoCi] 不做 resize、不做圆形 clip 的 raw 路径。
+// 直接把 bitmap 转 HICON 设进任务栏。bitmap 由调用方画好（含 bg 形状）。
+// 用于 DrawMoCiTaskbarBadge：非正方形（宽 > 高）+ 圆角矩形 bg。
+void SetMoCiOverlayIconRaw(HWND hwnd,
+                           std::unique_ptr<SkBitmap> bitmap,
+                           const std::string& alt_text) {
+  Microsoft::WRL::ComPtr<ITaskbarList3> taskbar;
+  HRESULT result = ::CoCreateInstance(
+      CLSID_TaskbarList, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&taskbar));
+  if (FAILED(result) || FAILED(taskbar->HrInit()))
+    return;
+
+  base::win::ScopedGDIObject<HICON> icon;
+  if (bitmap) {
+    icon = IconUtil::CreateHICONFromSkBitmap(*bitmap.get());
+    if (!icon.is_valid()) return;
+  }
+  taskbar->SetOverlayIcon(hwnd, icon.get(), base::UTF8ToWide(alt_text).c_str());
+}
+
+void PostSetMoCiOverlayIconRaw(HWND hwnd,
+                               std::unique_ptr<SkBitmap> bitmap,
+                               const std::string& alt_text) {
+  base::ThreadPool::CreateCOMSTATaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE})
+      ->PostTask(FROM_HERE, base::BindOnce(&SetMoCiOverlayIconRaw, hwnd,
+                                           std::move(bitmap), alt_text));
+}
