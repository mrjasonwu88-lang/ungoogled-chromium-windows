 void WindowsTaskbarIconUpdater::UpdateIcon() {
+  // [MoCi Sprint1 任务 3] 如 chrome 启动带 --moci-env-number=N，画数字 overlay
+  // badge (16×16 圆形 dark bg + 白色数字) 让吴总在 Windows 任务栏一眼区分
+  // 多 env chrome 实例。chromium 自带 taskbar::DrawTaskbarDecorationString
+  // 已经实现 skia 渲染，直接复用。
+  auto* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd && cmd->HasSwitch("moci-env-number")) {
+    std::string num_str = cmd->GetSwitchValueASCII("moci-env-number");
+    int env_num = 0;
+    if (base::StringToInt(num_str, &env_num) && env_num > 0) {
+      // [MoCi 任务 3 优化] 解析 --moci-badge-color=#RRGGBB 让 badge 底色同步组织主题色
+      std::optional<SkColor> bg = std::nullopt;
+      if (cmd->HasSwitch("moci-badge-color")) {
+        std::string hex = cmd->GetSwitchValueASCII("moci-badge-color");
+        // 接受 "#RRGGBB" 或 "RRGGBB"
+        if (!hex.empty() && hex[0] == '#') hex = hex.substr(1);
+        if (hex.size() == 6) {
+          uint32_t rgb = 0;
+          if (base::HexStringToUInt(hex, &rgb)) {
+            bg = SkColorSetRGB((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+          }
+        }
+      }
+      // v2.5.x++ : 改走 DrawMoCiTaskbarBadge —— 上半 mini shield + 下半大字数字。
+      //           前一版 "#" 前缀让 auto-fit 把字号缩到 7px 看不清；shield 取代 "#"
+      //           做 MoCi 标识，数字独立大区域可用 10-12px。alt_text 保留 "#N" 给 SR。
+      taskbar::DrawMoCiTaskbarBadge(
+          browser_view_->GetNativeWindow(),
+          num_str,
+          "MoCi Env #" + num_str,
+          bg);
+      return;
+    }
+  }
   taskbar::UpdateTaskbarDecoration(browser_view_->browser()->profile(),
                                    browser_view_->GetNativeWindow());
 }
