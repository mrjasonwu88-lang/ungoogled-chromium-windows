+// [MoCi v2.5.x] env-number badge：高 16 + 宽自适应（pill 形状）+ "#" 前缀。
+// 跟微信/QQ 任务栏数字标 same idea —— pill 横向拉到刚好装下 "#N" 完整字符串。
+// 因为宽度自适应，"#" 和数字可以用同一字号 14px 一次性 drawSimpleText，
+// 不再受 16×16 物理极限挤压字号 → 解决之前"#" 7px 糊 / 拆两次字体不一致的问题。
+// 走 SetMoCiOverlayIconRaw 直传 HICON，不进 chromium 自带的圆形 clip 路径。
+void DrawMoCiTaskbarBadge(gfx::NativeWindow window,
+                          const std::string& num_str,
+                          const std::string& alt_text,
+                          std::optional<SkColor> bg_color) {
+  HWND hwnd = views::HWNDForNativeWindow(window);
+
+  const SkColor kBgColor =
+      bg_color.value_or(SkColorSetRGB(0x26, 0x25, 0x2D));
+  constexpr SkColor kFgColor = SK_ColorWHITE;
+
+  // 2× 超采样 16×16 任务栏 slot：基础高 32，宽随字符数自适应
+  //   1 位 "#N"（2 字符）→ 32×32 正方形（Windows 1:1 缩槽位最大字）
+  //   2 位 "#NN"（3 字符）→ 40×32（Windows 轻 letterbox 到 16×13，字号能保 22px）
+  //   3+ 位（≥100）→ 去掉 "#" 直接显示数字，字符仍 3-4 个保持读得清
+  constexpr int kHeight = kOverlayIconSize * 2;        // 32
+  constexpr int kCornerRadius = 8;
+  constexpr int kHPadding = 2;
+
+  // 2 位数+ 去 "#"（吴总确认：单数字保留 # 区分未读消息计数；多位数视觉够明显不需要 #）
+  const std::string content = (num_str.size() >= 2) ? num_str : ("#" + num_str);
+
+  // 宽度按 content 字符数：2 字符 → 32（方），3 → 40，4 → 48，5+ → 56
+  int width = kHeight;
+  if (content.size() == 3) width = 40;
+  else if (content.size() == 4) width = 48;
+  else if (content.size() >= 5) width = 56;
+
+  SkFont font = skia::DefaultFont();
+  font.setSubpixel(false);
+  font.setEdging(SkFont::Edging::kAntiAlias);
+
+  // text 必须同时 fit 宽（width - 2*kHPadding）和高（kHeight - 6）
+  const int kMaxWidth = width - kHPadding * 2;
+  constexpr int kMaxHeight = kHeight - 6;              // 26
+  constexpr int kMaxTextSize = 28;
+  constexpr int kMinTextSize = 12;
+  SkRect bounds;
+  int text_size = kMaxTextSize;
+  do {
+    font.setSize(text_size--);
+    font.measureText(content.c_str(), content.size(),
+                     SkTextEncoding::kUTF8, &bounds);
+  } while (text_size >= kMinTextSize &&
+           (bounds.width() > kMaxWidth || bounds.height() > kMaxHeight));
+
+  auto badge = std::make_unique<SkBitmap>();
+  badge->allocN32Pixels(width, kHeight);
+  SkCanvas canvas(*badge.get(),
+                  skia::LegacyDisplayGlobals::GetSkSurfaceProps());
+  canvas.clear(SK_ColorTRANSPARENT);
+
+  // ① 圆角方块 bg
+  SkPaint bg_paint;
+  bg_paint.setAntiAlias(true);
+  bg_paint.setColor(kBgColor);
+  SkRRect bg_rrect = SkRRect::MakeRectXY(
+      SkRect::MakeWH(width, kHeight), kCornerRadius, kCornerRadius);
+  canvas.drawRRect(bg_rrect, bg_paint);
+
+  // ② 内容居中 + 整像素对齐
+  SkPaint text_paint;
+  text_paint.setAntiAlias(true);
+  text_paint.setColor(kFgColor);
+  const float cx = width / 2.0f;
+  const float cy = kHeight / 2.0f;
+  const float x = std::floorf(cx - bounds.width() / 2 - bounds.x());
+  const float y = std::floorf(cy - bounds.height() / 2 - bounds.y());
+  canvas.drawSimpleText(content.c_str(), content.size(),
+                        SkTextEncoding::kUTF8, x, y,
+                        font, text_paint);
+
+  PostSetMoCiOverlayIconRaw(hwnd, std::move(badge), alt_text);
+}
