+// [MoCi v.215] inline noise injection — 用于每个 transcendental 函数主返回路径
+// fast path (special cases like NaN/Inf/0) 不 wrap，避免破坏 IEEE 754 contract。
+// 算法：env var MOCI_MATH_NOISE_SEED (chrome PreSandboxStartup set per env id)
+// → splitmix64(bits ^ seed ^ fn_hash) → 末 2 bit XOR mantissa LSB → 1-2 bit
+// 末位 noise → String(Math.acos(x)).slice(-12) 末位字符跨 env 不同。
+// 数值精度损失 ~10^-15 (IEEE 754 mantissa last 2 bit)，无 perceptible 影响。
+static uint32_t moci_get_noise_seed() {
+  static uint32_t s_seed = UINT32_MAX;  // UINT32_MAX = "not yet read"
+  if (s_seed != UINT32_MAX) return s_seed;
+  const char* env = std::getenv("MOCI_MATH_NOISE_SEED");
+  s_seed = (env && *env) ? static_cast<uint32_t>(std::atoi(env)) : 0;
+  return s_seed;
+}
+
+static inline double moci_noise(double v, const char* fn_name) {
+  uint32_t seed = moci_get_noise_seed();
+  if (seed == 0) return v;
+  if (!std::isfinite(v) || v == 0.0) return v;
+  uint32_t fn_hash = 0x811c9dc5u;
+  for (const char* p = fn_name; *p; ++p) {
+    fn_hash ^= static_cast<uint8_t>(*p);
+    fn_hash *= 0x01000193u;
+  }
+  uint64_t bits;
+  static_assert(sizeof(bits) == sizeof(v), "double != 64 bit");
+  std::memcpy(&bits, &v, sizeof(bits));
+  uint64_t h = bits ^ static_cast<uint64_t>(seed) ^ (static_cast<uint64_t>(fn_hash) << 32);
+  h = (h ^ (h >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  h = (h ^ (h >> 27)) * 0x94d049bb133111ebULL;
+  h ^= h >> 31;
+  bits ^= (h & 0x3ULL);  // 末 2 bit XOR
+  std::memcpy(&v, &bits, sizeof(bits));
+  return v;
+}
