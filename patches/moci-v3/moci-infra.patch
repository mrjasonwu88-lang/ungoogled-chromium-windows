+  // MoCi: load --fingerprint-config JSON into the process-wide singleton.
+  // Idempotent: re-entered by every process type (browser/renderer/utility/gpu)
+  // but Init() ignores second call. Each process inherits the switch via
+  // Chromium's default child command line propagation.
+  moci::MoCiFingerprintConfig::Init(
+      command_line.GetSwitchValuePath(switches::kFingerprintConfig));
+
+  // [MoCi v.215 V8 Math hook] 让 V8 base/ieee754.cc 里 8 个 transcendental
+  // (acos/atanh/expm1/log1p/log2/log10/sinh/cosh) 主返回路径加 1-2 bit 末位 noise
+  // per envId-derived seed → 真实风控站 (CreepJS/BrowserScan/FingerprintJS) 抓
+  // Math.acos(0.123).slice(-12) 跨 env 不同。V8 base/ieee754.cc 自己读
+  // MOCI_MATH_NOISE_SEED env var (避免 chrome layer cross-deps V8 internal header)。
+  // fail-safe: 没 config / seed=0 → 返原值。
+  {
+    char seed_buf[32];
+    snprintf(seed_buf, sizeof(seed_buf), "%u", moci::GetMathNoiseSeed());
+#if BUILDFLAG(IS_WIN)
+    _putenv_s("MOCI_MATH_NOISE_SEED", seed_buf);
+#else
+    setenv("MOCI_MATH_NOISE_SEED", seed_buf, 1);
+#endif
+  }
+
+  // [MoCi v.216 Phase 5 #2] WASM features mask
+  // V8 wasm/wasm-features.cc 自己读 MOCI_WASM_FEATURES_MASK env var (hex 32-bit)
+  // FromFlags / FromContext 返回前按 mask bit i 调用 Remove(WasmEnabledFeature(i))
+  // 关掉 flagged experimental features，跨 env featuresMask 不同 → wasm hash 不同
+  // always-enabled features (SIMD/GC/threads/memory64) V8 硬编码不可控
+  // fail-safe: 没 config / mask=0 → 返 0 即不动 features
+  {
+    char mask_buf[32];
+    snprintf(mask_buf, sizeof(mask_buf), "%x", moci::GetWasmFeaturesMask());
+#if BUILDFLAG(IS_WIN)
+    _putenv_s("MOCI_WASM_FEATURES_MASK", mask_buf);
+#else
+    setenv("MOCI_WASM_FEATURES_MASK", mask_buf, 1);
+#endif
+  }
+
+  // [MoCi fp-08] Export the fingerprint-config path as env var so BoringSSL
+  // (which can't depend on //base) can read it via getenv() to derive a
+  // deterministic TLS GREASE seed per environment. Without this, TLS GREASE
+  // values vary per handshake → JA3 hash unstable. With this, JA3 hash is
+  // stable within an environment and varies across environments. Set in
+  // PreSandboxStartup so the value is in env before any child process spawns
+  // or sandbox lockdown happens.
+  {
+    auto fp_path = command_line.GetSwitchValueNative(
+        switches::kFingerprintConfig);
+    if (!fp_path.empty()) {
+#if BUILDFLAG(IS_WIN)
+      _wputenv_s(L"MOCI_FINGERPRINT_CONFIG_PATH", fp_path.c_str());
+#else
+      setenv("MOCI_FINGERPRINT_CONFIG_PATH", fp_path.c_str(), 1);
+#endif
+    }
+  }
+
   crash_reporter::InitializeCrashKeys();
 
