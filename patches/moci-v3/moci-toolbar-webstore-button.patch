+ public:
+  explicit MoCiStoreButton(PressedCallback callback);
+  MoCiStoreButton(const MoCiStoreButton&) = delete;
+  MoCiStoreButton& operator=(const MoCiStoreButton&) = delete;
+  ~MoCiStoreButton() override;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_MOCI_STORE_BUTTON_H_
